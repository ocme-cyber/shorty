<!doctype html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <title>Профиль | Шорти</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #07111f, #0f2747);
            color: white;
            min-height: 100vh;
        }

        header {
            height: 70px;
            background: rgba(17, 27, 47, .9);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 50px;
            border-bottom: 1px solid #27446e;
        }

        .logo {
            font-size: 30px;
            font-weight: bold;
        }

        .logo span {
            color: #4f8cff;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 30px;
        }

        nav a:hover {
            color: #4f8cff;
        }

        .container {
            width: 900px;
            margin: 50px auto;
        }

        .profile {
            background: rgba(17, 27, 47, .85);
            border-radius: 18px;
            padding: 30px;
        }

        .profile h1 {
            margin-bottom: 10px;
        }

        .stats {
            display: flex;
            gap: 20px;
            margin: 30px 0;
        }

        .stat {
            flex: 1;
            background: #18243d;
            padding: 20px;
            border-radius: 12px;
            text-align: center;
        }

        .stat h2 {
            color: #4f8cff;
            margin-bottom: 10px;
        }

        h3 {
            margin-bottom: 20px;
        }

        .link {
            background: #18243d;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .link-info {
            flex: 1;
            min-width: 0;
        }

        .original,
        .short {
            overflow-wrap: break-word;
            word-break: break-word;
        }

        .short {
            color: #4f8cff;
            font-weight: bold;
            margin-top: 8px;
        }

        .clicks {
            flex-shrink: 0;
            text-align: right;
            color: #ccc;
        }

        button {
            margin-top: 30px;
            padding: 12px 25px;
            border: none;
            border-radius: 10px;
            background: #3b82f6;
            color: white;
            cursor: pointer;
        }

        button:hover {
            background: #2563eb;
        }
        a {
            color: rgb(15, 39, 173);
            width: 300;
        }
                #alert {
            position: fixed;
            top: 25px;
            left: 50%;
            transform: translateX(-50%) translateY(-20px);
            min-width: 320px;
            max-width: 600px;
            padding: 16px 24px;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 600;
            color: white;
            text-align: center;
            opacity: 0;
            transition: all .3s ease;
            pointer-events: none;
            z-index: 1000;
            box-shadow: 0 10px 25px rgba(0, 0, 0, .35);
        }

        #logout {
            cursor: pointer;
        }

        #alert.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }
        
        #alert.success {
            background: #22c55e;
        }

        #alert.error {
            background: #ef4444;
        }

        #alert.info {
            background: #3b82f6;
        }
    </style>
</head>

<body>
    <div id="alert"></div>
    <header>
        <div class="logo">
            Шорти<span>.</span>
        </div>

        <nav>
            <a href="/">Главная</a>
            <a href="/profile">Профиль</a>
            <a id="logout">Выйти</a>
        </nav>
    </header>

    <div class="container">

        <div class="profile">

            <h1>Привет, <%= user.login %>!</h1>
            <p>Добро пожаловать в личный кабинет.</p>

            <div class="stats">

                <div class="stat">
                    <h2><%= userUrls.length%></h2>
                    <p>Количество ссылок</p>
                </div>

                <div class="stat">
                    <h2><%= userUrls.reduce((acc, url) => {
                        return acc + url.clicks
                    }, 0) %></h2>
                    <p>Переходов</p>
                </div>

            </div>

            <h3>Ваши ссылки</h3>

            <% userUrls.forEach(url => { %>
                <div class="link">
                    <div class="link-info">
                        <div class="original">
                            <a href=" <%= url.originalUrl %> ">
                                <%= url.originalUrl %>
                            </a>
                        </div>

                        <div class="short">
                            <a href="<%= url.shortUrl %>"><%= url.shortUrl %>
                            </a>
                        </div>
                    </div>

                    <div class="clicks">
                        Кол-во переходов <%= url.clicks %>
                    </div>
                </div>
            <% }); %>

            <button hre>
                Создать новую ссылку
            </button>

        </div>

    </div>

</body>

</html>

<script> 
    const logout = document.querySelector("#logout")
    console.log(logout)
    logout.addEventListener('click', () => {
        fetch("/user/logout", {
            method: 'POST',
        }).then(response => {
            response.json().then(data => {
                console.log(data)
                if (data.success) {
                    showAlert("Успешный выход, переадресация", "success");

                    setTimeout(() => {
                        document.location = "/";
                    }, 1000);
                } else {
                    showAlert(data.message, "error");
                }
            })
        })
    })
    let alertTimer;

    function showAlert(message, type = "info") {
        const alert = document.getElementById("alert");

        clearTimeout(alertTimer);

        alert.textContent = message;
        alert.className = `${type} show`;

        alertTimer = setTimeout(() => {
            alert.classList.remove("show");
        }, 10000);
    }
</script>